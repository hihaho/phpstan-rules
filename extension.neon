parametersSchema:
    noUnsafeRequestData: structure([
        unsafeMethods: listOf(string())
        namespaces: listOf(string())
        excludeNamespaces: listOf(string())
    ])
    unvalidatedFormRequestField: structure([
        accessors: listOf(string())
    ])
    positionalFlagArgument: structure([
        firstPartyNamespaces: listOf(string())
    ])
    stubbedMethods: arrayOf(arrayOf(string()))
    routeBindingProviders: listOf(string())
    routeFiles: listOf(string())
    traitRequiresInterface: arrayOf(string())
    outlierTables: listOf(string())
    unescapedHtml: structure([
        namespaces: listOf(string())
        excludeNamespaces: listOf(string())
    ])

parameters:
    # class name => (method name => return type string). Resolves runtime-only instance methods
    # (Faker providers, macros) so they need no baseline, while typos still fail.
    # Empty by default — each consuming project configures its own.
    stubbedMethods: []

    # Provider class names whose source is parsed for Route::model()/Route::bind() bindings, used to
    # type $this->route('x') as the bound model. Empty by default — each project lists its providers.
    routeBindingProviders: []

    # Route file paths parsed for implicit (controller type-hint) route-model bindings, used as the
    # fallback for $this->route('x') when 'x' is not declared in a provider. Empty by default.
    routeFiles: []

    # trait FQCN => interface FQCN every class using that trait must implement. PHP cannot express
    # this requirement itself. Empty by default — each consuming project configures its own pairs.
    traitRequiresInterface: []

    # Tables whose row count makes any rebuilding DDL a production incident. Migrations touching
    # them may only do work MySQL is told to do instantly. Empty by default — each project
    # measures its own row counts before deciding.
    outlierTables: []

    # Namespaces checked for unescaped values reaching raw-HTML sinks: the content arguments of
    # spatie/laravel-html builder methods and the closures of Nova ->asHtml() fields. Empty by
    # default — the rules are inert until a project opts in.
    unescapedHtml:
        namespaces: []
        excludeNamespaces: []

    noUnsafeRequestData:
        unsafeMethods:
            - input
            - all
            - get
            - query
            - post
            - only
            - except
            - collect
            - string
            - str
            - integer
            - boolean
            - float
            - json
            - keys
            - fluent
            - array
            - date
            - enum
            - enums
            - file
            - allFiles
        namespaces:
            - App
        excludeNamespaces:
            - App\Providers
            - App\Http\Responses
    unvalidatedFormRequestField:
        accessors:
            - input
            - get
            - query
            - post
            - string
            - str
            - integer
            - boolean
            - float
            - json
            - array
            - collect
            - date
            - enum
            - enums
            - file
    positionalFlagArgument:
        firstPartyNamespaces:
            - App
            - Database\Factories
            - Tests

rules:
    - Hihaho\PhpstanRules\Rules\Conventions\NoEloquentWithPropertyRule

services:
    -
        class: Hihaho\PhpstanRules\Rules\CombinedFuncCallRule
        arguments:
            namespaces: %noUnsafeRequestData.namespaces%
            excludeNamespaces: %noUnsafeRequestData.excludeNamespaces%
            reflectionProvider: @reflectionProvider
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\CombinedStaticCallRule
        arguments:
            unsafeMethods: %noUnsafeRequestData.unsafeMethods%
            namespaces: %noUnsafeRequestData.namespaces%
            excludeNamespaces: %noUnsafeRequestData.excludeNamespaces%
            firstPartyNamespaces: %positionalFlagArgument.firstPartyNamespaces%
            htmlSink: @Hihaho\PhpstanRules\Rules\Html\HtmlBuilderContentSink
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\CombinedMethodCallRule
        arguments:
            unsafeMethods: %noUnsafeRequestData.unsafeMethods%
            fieldAccessors: %unvalidatedFormRequestField.accessors%
            namespaces: %noUnsafeRequestData.namespaces%
            excludeNamespaces: %noUnsafeRequestData.excludeNamespaces%
            parser: @defaultAnalysisParser
            firstPartyNamespaces: %positionalFlagArgument.firstPartyNamespaces%
            htmlSink: @Hihaho\PhpstanRules\Rules\Html\HtmlBuilderContentSink
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\Conventions\PositionalFlagArgumentConstructorRule
        arguments:
            reflectionProvider: @reflectionProvider
            firstPartyNamespaces: %positionalFlagArgument.firstPartyNamespaces%
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\Conventions\PositionalFlagArgumentNullsafeMethodCallRule
        arguments:
            firstPartyNamespaces: %positionalFlagArgument.firstPartyNamespaces%
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\Conventions\TraitRequiresInterfaceRule
        arguments:
            traitRequiresInterface: %traitRequiresInterface%
            reflectionProvider: @reflectionProvider
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\Database\BlueprintChain
        arguments:
            reflectionProvider: @reflectionProvider
    -
        class: Hihaho\PhpstanRules\Rules\Database\ByReferenceArguments
        arguments:
            reflectionProvider: @reflectionProvider
    -
        class: Hihaho\PhpstanRules\Rules\Database\PropertyMutations
        arguments:
            byReference: @Hihaho\PhpstanRules\Rules\Database\ByReferenceArguments
    -
        class: Hihaho\PhpstanRules\Rules\Database\PropertyArraySource
        arguments:
            mutations: @Hihaho\PhpstanRules\Rules\Database\PropertyMutations
    -
        class: Hihaho\PhpstanRules\Rules\Database\ArrayDefinitionReader
        arguments:
            source: @Hihaho\PhpstanRules\Rules\Database\PropertyArraySource
    -
        class: Hihaho\PhpstanRules\Rules\Database\HelperCallSites
    -
        class: Hihaho\PhpstanRules\Rules\Database\BlueprintDefinitionResolver
        arguments:
            arrays: @Hihaho\PhpstanRules\Rules\Database\ArrayDefinitionReader
            helpers: @Hihaho\PhpstanRules\Rules\Database\HelperCallSites
    -
        class: Hihaho\PhpstanRules\Rules\Database\RawAlterScanner
        arguments:
            outlierTables: %outlierTables%
    -
        class: Hihaho\PhpstanRules\Rules\Database\SlowMigrationDdlRule
        arguments:
            outlierTables: %outlierTables%
            chain: @Hihaho\PhpstanRules\Rules\Database\BlueprintChain
            scanner: @Hihaho\PhpstanRules\Rules\Database\RawAlterScanner
            definitions: @Hihaho\PhpstanRules\Rules\Database\BlueprintDefinitionResolver
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\Html\HtmlSafetyJudge
    -
        class: Hihaho\PhpstanRules\Rules\Html\HtmlBuilderContentSink
        arguments:
            namespaces: %unescapedHtml.namespaces%
            excludeNamespaces: %unescapedHtml.excludeNamespaces%
            judge: @Hihaho\PhpstanRules\Rules\Html\HtmlSafetyJudge
    -
        class: Hihaho\PhpstanRules\Rules\Html\HtmlFieldReturnSink
        arguments:
            namespaces: %unescapedHtml.namespaces%
            excludeNamespaces: %unescapedHtml.excludeNamespaces%
            judge: @Hihaho\PhpstanRules\Rules\Html\HtmlSafetyJudge
            reflectionProvider: @reflectionProvider
    -
        class: Hihaho\PhpstanRules\Rules\Html\HtmlFieldClosureVisitor
        tags:
            - phpstan.parser.richParserNodeVisitor
    -
        class: Hihaho\PhpstanRules\Rules\Html\UnescapedHtmlFieldClosureRule
        arguments:
            sink: @Hihaho\PhpstanRules\Rules\Html\HtmlFieldReturnSink
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Rules\Html\UnescapedHtmlFieldArrowFunctionRule
        arguments:
            sink: @Hihaho\PhpstanRules\Rules\Html\HtmlFieldReturnSink
        tags:
            - phpstan.rules.rule
    -
        class: Hihaho\PhpstanRules\Reflection\StubbedMethodsClassReflectionExtension
        arguments:
            stubbedMethods: %stubbedMethods%
        tags:
            - phpstan.broker.methodsClassReflectionExtension
    -
        class: Hihaho\PhpstanRules\ReturnTypes\CollectionListAllReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: Hihaho\PhpstanRules\ReturnTypes\ImplicitRouteBindingResolver
        arguments:
            routeFiles: %routeFiles%
            parser: @currentPhpVersionSimpleDirectParser
            reflectionProvider: @reflectionProvider
    -
        class: Hihaho\PhpstanRules\ReturnTypes\RouteBindingReturnTypeExtension
        arguments:
            routeBindingProviders: %routeBindingProviders%
            parser: @currentPhpVersionSimpleDirectParser
            reflectionProvider: @reflectionProvider
            implicitResolver: @Hihaho\PhpstanRules\ReturnTypes\ImplicitRouteBindingResolver
        tags:
            - phpstan.broker.expressionTypeResolverExtension
    -
        class: Hihaho\PhpstanRules\ParameterClosureTypes\RelationExistenceClosureBuilderParameterExtension
        arguments:
            reflectionProvider: @reflectionProvider
        tags:
            - phpstan.methodParameterClosureTypeExtension
